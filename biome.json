{
    "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": true,
        "includes": [
            "**",
            "!**/target",
            "!**/*.node",
            "!**/dist",
            "!**/node_modules",
            "!**/projects/sites",
            "!**/pkg",
            "!_rebase_*",
            "!_reword_*",
            "!_scan_*"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 144,
        "lineEnding": "lf"
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended"
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "trailingCommas": "all"
        }
    },
    "json": {
        "formatter": {
            "indentWidth": 4
        }
    },
    "overrides": [
        {
            "includes": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.mjs", "**/*.cjs"],
            "formatter": {
                "indentWidth": 4
            }
        },
        {
            "includes": ["**/*.json", "**/*.jsonc"],
            "formatter": {
                "indentWidth": 4
            }
        },
        {
            "includes": ["**/*.yaml", "**/*.yml"],
            "formatter": {
                "indentWidth": 2
            }
        }
    ]
}
