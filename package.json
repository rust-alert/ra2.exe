{
    "name": "ra2",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@9.15.4",
    "scripts": {
        "build:ts": "pnpm --filter @game-gpt/red-alert2 --filter @game-gpt/red-alert2-unknown-wasm32 run build",
        "build:native": "node scripts/build/napi.mjs --release",
        "build": "pnpm run build:ts && pnpm run build:native",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "fmt": "biome format --write . && cargo fmt --all",
        "fmt:check": "biome format . && cargo fmt --all -- --check",
        "publish:npm": "node scripts/ci/publish-npm.mjs"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.12",
        "@game-gpt/red-alert2": "workspace:*",
        "typescript": "^5.8.3"
    }
}
