{
    "name": "@game-gpt/red-alert2",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Modern rewrite of Command & Conquer: Red Alert 2. Desktop CLI (`ra2 launch --path`), Node N-API host, and browser Wasm face. Bring your own legal game install. Not a DirectDraw shim and not an injector for the retail exe.",
    "repository": {
        "type": "git",
        "url": "https://github.com/rust-alert/ra2.exe.git",
        "directory": "projects/hosts/red-alert2"
    },
    "homepage": "https://github.com/rust-alert/ra2.exe/tree/master/projects/hosts/red-alert2",
    "bugs": {
        "url": "https://github.com/rust-alert/ra2.exe/issues"
    },
    "keywords": [
        "red-alert-2",
        "command-and-conquer",
        "ra2",
        "yuris-revenge",
        "napi",
        "wasm",
        "webgl2",
        "cli",
        "rts"
    ],
    "license": "Apache-2.0",
    "bin": {
        "ra2": "./bin/ra2.mjs"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./native": {
            "types": "./dist/native.d.ts",
            "default": "./dist/native.js"
        },
        "./wasm": {
            "types": "./dist/wasm.d.ts",
            "default": "./dist/wasm.js"
        }
    },
    "files": [
        "dist",
        "bin",
        "README.md"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json"
    },
    "optionalDependencies": {
        "@game-gpt/red-alert2-win32-x64": "workspace:*",
        "@game-gpt/red-alert2-linux-x64": "workspace:*",
        "@game-gpt/red-alert2-darwin-arm64": "workspace:*",
        "@game-gpt/red-alert2-darwin-x64": "workspace:*",
        "@game-gpt/red-alert2-unknown-wasm32": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^22.15.0",
        "typescript": "^5.8.3"
    }
}
