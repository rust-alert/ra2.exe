# RustAlert 桌面启动配置
#
# 将本文件复制为可执行文件同目录下的 `RustAlert.toml` 后按需修改。
# 若启动时尚无该文件，程序会自动生成一份默认配置以便持久化。
# 分辨率、显示与其它启动选项写在本文件中。
# 默认情形：未改 `ra2_dir` 时取 exe 所在目录——把 `rust-ra2` / `rust-ra2.exe`
# 放进游戏安装目录即可定位资源。

# ra2_dir = "C:/path/to/your/ra2"
# display_mode = "1024x768"   # 640x480 / 800x600 / 1024x768
# music_volume = 0.4
# sound_volume = 0.7
# load_min_secs = 3.0   # 遭遇战装载页最短展示秒数（0 关闭）
# shell_slide_gap_secs = 0.2   # 出去→进来停顿，模拟原版重型机械卡顿（0 关闭）
# palette_vga_expand = "full"  # full=*255/63 满幅 | shift2=左移二位（最高 252）
# edition = "ra2"   # 或 "yr"。合集盘务必写明；省略则自动探测，可能落到 YR
# screen = "skirmish"  # 可选启动页：splash / main / single / campaign / skirmish / choose_map / options
# net_url = ""      # 预留战网地址
# net_room = ""     # 预留房间名

# 壳层质感呈现（模拟原版 16 位色观感）
# [present]
# mode = "16bit"              # off | 16bit
# quantize = "rgb565"         # rgb565 | rgb555
# dither = true
